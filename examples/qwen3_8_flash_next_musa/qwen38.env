SGLANG_SET_CPU_AFFINITY=1
PYTORCH_MUSA_ALLOC_CONF=expandable_segments:True
SGLANG_FL_FLAGOS_BLACKLIST=count_nonzero,cumsum,mm,unique,_unique2,unique_dim,unique_consecutive
SGLANG_FL_MROPE_FORCE_TORCH=0
SGLANG_MOE_PADDING=1
SGLANG_USE_MUSA_FUSED_KERNEL=1
SGLANG_USE_DEEPGEMM_BMM=0

# Keep speculative decoding disabled until token parity, 16-concurrent
# accuracy, soak stability, and performance A/B all pass.
SGLANG_QWEN4_ENABLE_NEXTN=0
